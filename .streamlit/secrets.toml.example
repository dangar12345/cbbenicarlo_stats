# Copia este archivo a .streamlit/secrets.toml (local) o pega el contenido en
# Settings -> Secrets de Streamlit Community Cloud. No commitear el real.
#
# La app es pública: no hay contraseña de acceso. Lo que se protege son los
# FICHEROS del repo (parquet cifrados en data/enc/); esta clave permite a la
# app descifrarlos en memoria, pero al vivir fuera de git nadie puede
# descargar los datos crudos desde GitHub.
#
# Generar DATA_KEY:
#   .venv/bin/python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DATA_KEY = "pega-aqui-la-clave-fernet"
